#!/usr/bin/env bash

# ============================================================================ #
# OctalFont Build and Management Script                                        #
# Version: 0.1.0                                                               #
#                                                                              #
# DESCRIPTION:                                                                 #
#   A unified interface for managing the OctalFont development environment.    #
#   Handles virtual environment creation, dependency resolution (pip-tools),   #
#   font compilation (fontmake), and automated testing.                        #
#                                                                              #
# OS SUPPORT:                                                                  #
#   - Linux / macOS (Native)                                                   #
#   - Windows (via Git Bash / MSYS2 / Cygwin)                                  #
#                                                                              #
# USAGE:                                                                       #
#   ./octalfont [command] [-l|--log]                                           #
#                                                                              #
# COMMANDS:                                                                    #
#   build     - Compile all OctalFont subfonts and output to build             #
#   test      - Run the test suite located in 'tests'                          #
#   update    - Update Python dependencies from requirements                   #
#   clean     - Remove build artifacts and virtual environment                 #
#   help      - Show help message                                              #
#                                                                              #
# OPTIONS:                                                                     #
#   -l, --log  - Enable session logging to 'logs/' directory                   #
# ============================================================================ #

set -e
set -u
set -o pipefail

# ============================================================================ #
#                                   Variables                                  #
# ============================================================================ #

# Configuration
FONT_FAMILY="OctalFont"
FONT_SUBFONTS=("Cuprum" "Titan" "Mercury")
FONT_VERSION="0.1.0"

export LOG_LEVEL=INFO
export LOG_DIR="logs"

SCRIPT_NAME="$(basename "$0")"
SCRIPT_VERSION="0.1.0"

# Project Structure
ROOT="$(cd "$(dirname "$0")" && pwd)"
PYTHON_EXE=""
VENV="${ROOT}/venv"
BUILD="${ROOT}/build"
SHELL_TOOLS="${ROOT}/tools/shell"
REQS_IN="${ROOT}/requirements.in"
REQS_TXT="${ROOT}/requirements.txt"
REQS_TEST_IN="${ROOT}/requirements-test.in"
REQS_TEST_TXT="${ROOT}/requirements-test.txt"
VENV_SUCCESS_MARKER="${VENV}/setup_complete.marker"

PATH_VARS=(ROOT VENV BUILD SHELL_TOOLS REQS_IN REQS_TXT REQS_TEST_IN REQS_TEST_TXT VENV_SUCCESS_MARKER)
ENABLE_SESSION_LOG=false
COMMAND=""

# Command descriptions mapping
declare -A COMMAND_MAP_DESC=(
    [build]="🔨 Build all ${FONT_FAMILY} subfonts and output to build"
    [test]="🧪 Run the test suite located in 'tests'"
    [update]="⬆️ Update Python dependencies from requirements"
    [clean]="🧹 Remove build artifacts and virtual environment"
    [help]="❓ Show help message"
)

# Command to function mapping
declare -A COMMAND_MAP_FUNC=(
    [build]=build_fonts
    [test]=run_tests
    [update]=update_dependencies
    [clean]=clean_all
    [help]=show_help
)

# ============================================================================ #
#                                 OS Detection                                 #
# ============================================================================ #
# Detect the operating system to handle path normalization and binary naming.  #
# ============================================================================ #

IS_WINDOWS=false
IS_DARWIN=false

case "$(uname -s)" in
    CYGWIN*|MSYS*|MINGW*) IS_WINDOWS=true ;;
    Darwin*)              IS_DARWIN=true ;;
esac

# Normalize paths
for var_name in "${PATH_VARS[@]}"; do
    if ${IS_WINDOWS}; then
        eval "${var_name}=\"\$(cygpath -m \"\${${var_name}}\")\""
    elif ${IS_DARWIN}; then
        eval "${var_name}=\"\$(realpath \"\${${var_name}}\")\""
    fi
done

# Set binary directory structure based on OS
if ${IS_WINDOWS}; then
    BIN_DIR="Scripts"
    EXE=".exe"
else
    BIN_DIR="bin"
    EXE=""
fi

# Tool paths within the virtual environment
VENV_PYTHON_CMD="${VENV}/${BIN_DIR}/python${EXE}"
PIP_CMD="${VENV}/${BIN_DIR}/pip${EXE}"
PIP_COMPILE_CMD="${VENV}/${BIN_DIR}/pip-compile${EXE}"
PIP_SYNC_CMD="${VENV}/${BIN_DIR}/pip-sync${EXE}"
FONTMAKE_CMD="${VENV}/${BIN_DIR}/fontmake${EXE}"
PYTEST_CMD="${VENV}/${BIN_DIR}/pytest${EXE}"

# ============================================================================ #
#                                Core Functions                                #
# ============================================================================ #
# Defines the main operations for managing the OctalFont project.              #
# ============================================================================ #

# Locates a valid Python 3 interpreter on the system PATH.
function ensure_python {
    [ -n "${PYTHON_EXE}" ] && return 0

    for cmd in python3 python py; do
        if command -v "${cmd}" &> /dev/null && "${cmd}" -c "import sys; exit(0 if sys.version_info.major == 3 else 1)" &> /dev/null; then
            PYTHON_EXE="${cmd}"
            return 0
        fi
    done

    error "Python 3 not found. Please install Python major version 3 and ensure it's on your PATH." \
          "Visit https://www.python.org/downloads/ for installation instructions."
    return 1
}

# Bootstraps the Python virtual environment if it doesn't exist.
function init_venv {
    if [ ! -f "${VENV_SUCCESS_MARKER}" ] || [ ! -f "${VENV_PYTHON_CMD}" ]; then
        info "Virtual environment is missing or corrupted. Initializing..."

        [ -d "${VENV}" ] && rm -rf "${VENV}"
        ensure_python

        info "Creating venv at ${VENV} using ${PYTHON_EXE}..."
        "${PYTHON_EXE}" -m venv "${VENV}"

        info "Upgrading bootstrap tools (pip)..."
        "${VENV_PYTHON_CMD}" -m pip install --upgrade pip

        install_dependencies
        touch "${VENV_SUCCESS_MARKER}"
        success "Virtual environment is ready."
    fi
}

# Installs dependencies from requirements.txt files into the venv.
function install_dependencies {
    info "Installing dependencies..."

    local REQS=()
    [ -f "${REQS_TXT}" ] && REQS+=("-r" "${REQS_TXT}")
    [ -f "${REQS_TEST_TXT}" ] && REQS+=("-r" "${REQS_TEST_TXT}")

    if [ ${#REQS[@]} -gt 0 ]; then
        "${VENV_PYTHON_CMD}" -m pip install "${REQS[@]}"
    else
        warn "No requirements.txt found. Skipping installation."
    fi
}

# Compiles the font sources into final binaries.
function build_fonts {
    init_venv

    info "Starting build process for ${FONT_FAMILY}..."
    rm -rf "${BUILD}"
    mkdir -p "${BUILD}"

    # TODO: Add build logic here using fontmake
}

# Executes the test suite using pytest.
function run_tests {
    init_venv

    if [ ! -f "${PYTEST_CMD}" ]; then
        error "Pytest not found. Run '${SCRIPT_NAME} update' first."
        exit 1
    fi

    info "Running tests..."
    "${PYTEST_CMD}" "${ROOT}/tests"
}

# Updates dependencies from requirements.in using pip-tools.
function update_dependencies {
    init_venv
    info "Updating Python dependencies (pip-tools)..."
    "${PIP_CMD}" install --upgrade pip pip-tools

    if [ -f "${REQS_IN}" ]; then
        info "Compiling requirements.in -> requirements.txt..."
        "${PIP_COMPILE_CMD}" --upgrade --resolver=backtracking "${REQS_IN}"

        if [ -f "${REQS_TEST_IN}" ]; then
            info "Compiling requirements-test.in with constraints..."
            "${PIP_COMPILE_CMD}" --upgrade --resolver=backtracking \
                --constraint "${REQS_TXT}" \
                "${REQS_TEST_IN}"
        fi

        info "Syncing environment with new lockfiles..."
        if [ -f "${REQS_TEST_TXT}" ]; then
            "${PIP_SYNC_CMD}" "${REQS_TXT}" "${REQS_TEST_TXT}"
        else
            "${PIP_SYNC_CMD}" "${REQS_TXT}"
        fi
    else
        warn "No requirements.in found. Falling back to simple install."
        install_dependencies
    fi

    success "Dependencies successfully synchronized."
}

# Wipes all temporary directories and cache files.
function clean_all {
    info "Cleaning build artifacts and virtual environment..."

    rm -rf "${BUILD}" "${VENV}" "${ROOT}/out"
    find "${ROOT}" -name "*.pyc" -delete
    find "${ROOT}" -name "__pycache__" -type d -exec rm -rf {} +

    success "Environment cleaned."
}

# Displays the help menu.
function show_help {
    echo -e "${BLUE}Font Management Script - Version ${SCRIPT_VERSION}${RESET}"
    echo -e "${BLUE}Font Family:${RESET} ${FONT_FAMILY} v${FONT_VERSION}"
    echo -e "${BLUE}Subfonts:${RESET} ${FONT_SUBFONTS[*]/#/${FONT_FAMILY}-}"
    echo
    echo -e "${GREEN}Usage:${RESET} ${SCRIPT_NAME} [command] [-l|--log]"
    echo
    echo -e "${YELLOW}Available Commands:${RESET}"
    for cmd in $(echo "${!COMMAND_MAP_DESC[@]}" | tr ' ' '\n' | sort); do
        printf "  %-10s %s\n" "${cmd}" "${COMMAND_MAP_DESC[${cmd}]}"
    done
    echo
    echo -e "${YELLOW}Options:${RESET}"
    echo -e "  -l, --log    Enable session logging to 'logs/' directory"
    echo
    echo -e "${BLUE}Documentation:${RESET}"
    echo -e "  - This script manages a Python venv for font engineering."
    echo -e "  - Use 'update' whenever you change requirements.in."
    echo -e "  - Build outputs are generated in the 'build/' directory."
    exit 1
}

# ============================================================================ #
#                                Main Execution                                #
# ============================================================================ #

# Load Shell Tools
source "${SHELL_TOOLS}/logging.sh"

# Parse optional flags
while [[ "$#" -gt 0 ]]; do
    case "$1" in
        -l|--log) ENABLE_SESSION_LOG=true;               shift ;;
        -*)       error "Unknown option: $1";            show_help ;;
        *)        [[ -z "${COMMAND}" ]] && COMMAND="$1"; shift ;;
    esac
done

# Start session logging if enabled
if ${ENABLE_SESSION_LOG}; then
    start_session_logging
fi

# Command validation
SELECTED_CMD="${COMMAND:-}"

if [[ -z "${SELECTED_CMD}" || -z "${COMMAND_MAP_FUNC[${SELECTED_CMD}]:-}" ]]; then
    [[ -n "${SELECTED_CMD}" ]] && error "Unknown command '${SELECTED_CMD}'"
    show_help
fi

# Git Integration:
# Automatically mark requirement files as "skip-worktree" to avoid accidental
# commits.
if command -v git >/dev/null 2>&1 && [ -d "${ROOT}/.git" ]; then
    for req_file in "${REQS_TXT}" "${REQS_TEST_TXT}"; do
        if [ -f "${req_file}" ]; then
            git update-index --skip-worktree "${req_file}" 2>/dev/null || true
        fi
    done
fi

# Route to the appropriate function
"${COMMAND_MAP_FUNC[${SELECTED_CMD}]}"
