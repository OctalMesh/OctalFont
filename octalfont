#!/usr/bin/env bash
set -e

# ========= #
# Variables #
# ========= #

# Font family and subfonts
FAMILY="OctalFont"
SUBFONTS=("Cuprum" "Titan" "Mercury")

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Command parsing
SCRIPT_NAME="$(basename "$0")"
COMMAND="$1"
shift || true

# Paths
ROOT="$(cd "$(dirname "$0")" && pwd)"
VENV="$ROOT/venv"
BUILD="$ROOT/build"
REQS_IN="$ROOT/requirements.in"
REQS_TXT="$ROOT/requirements.txt"
REQS_TEST_IN="$ROOT/requirements-test.in"
REQS_TEST_TXT="$ROOT/requirements-test.txt"

PATH_VARS=(ROOT VENV BUILD REQS_IN REQS_TXT REQS_TEST_IN REQS_TEST_TXT)

# Markers
VENV_SUCCESS_MARKER="$VENV/setup_complete.marker"

# Command descriptions
declare -A COMMAND_MAP_DESC=(
    [build]="🔨 Build all ${FAMILY} subfonts and output to build"
    [test]="🧪 Run tests in tests"
    [update]="⬆️ Update Python dependencies from requirements"
    [clean]="🧹 Remove build artifacts and virtual environment"
    [help]="❓ Show help message"
)

# Command functions
declare -A COMMAND_MAP_FUNC=(
    [build]=build_fonts
    [test]=run_tests
    [update]=update_dependencies
    [clean]=clean_all
    [help]=show_help
)

# ============ #
# OS Detection #
# ============ #

IS_WINDOWS=false
IS_DARWIN=false

# Detect OS
case "$(uname -s)" in
    CYGWIN*|MSYS*|MINGW*) IS_WINDOWS=true ;;
    Darwin*)              IS_DARWIN=true ;;
esac

# Normalize paths for Windows and macOS
for var_name in "${PATH_VARS[@]}"; do
    if $IS_WINDOWS; then
        eval "$var_name=\"\$(cygpath -m \"\${$var_name}\")\""
    elif $IS_DARWIN; then
        eval "$var_name=\"\$(realpath \"\${$var_name}\")\""
    fi
done

# Venv binaries
if $IS_WINDOWS; then
    BIN_DIR="Scripts"
    EXE=".exe"
else
    BIN_DIR="bin"
    EXE=""
fi

VENV_PYTHON_CMD="$VENV/$BIN_DIR/python$EXE"
PIP_CMD="$VENV/$BIN_DIR/pip$EXE"
PIP_COMPILE_CMD="$VENV/$BIN_DIR/pip-compile$EXE"
PIP_SYNC_CMD="$VENV/$BIN_DIR/pip-sync$EXE"
FONTMAKE_CMD="$VENV/$BIN_DIR/fontmake$EXE"
PYTEST_CMD="$VENV/$BIN_DIR/pytest$EXE"

# ========= #
# Functions #
# ========= #

log()     { echo -e "${BLUE}>> $1${NC}"; }
success() { echo -e "${GREEN}SUCCESS: $1${NC}"; }
warn()    { echo -e "${YELLOW}WARNING: $1${NC}"; }
error()   { echo -e "${RED}ERROR: $1${NC}"; }

function ensure_python {
    [ -n "$PYTHON_EXE" ] && return 0

    for cmd in python3 python py; do
        if command -v "$cmd" &> /dev/null && "$cmd" -c "import sys; exit(0 if sys.version_info.major == 3 else 1)" &> /dev/null; then
            PYTHON_EXE="$cmd"
            return 0
        fi
    done

    error "Python 3 not found."
    return 1
}

function init_venv {
    if [ ! -f "$VENV_SUCCESS_MARKER" ] || [ ! -f "$VENV_PYTHON_CMD" ]; then
        log "Virtual environment is missing or corrupted. Initializing..."

        [ -d "$VENV" ] && rm -rf "$VENV"

        ensure_python

        log "Creating venv..."
        "$PYTHON_EXE" -m venv "$VENV"

        log "Upgrading pip in the venv..."
        "$VENV_PYTHON_CMD" -m pip install --upgrade pip

        install_dependencies

        success "Virtual environment is ready."
        touch "$VENV_SUCCESS_MARKER"
    fi
}

function install_dependencies {
    log "Installing dependencies..."

    local REQS=()
    [ -f "$REQS_TXT" ] && REQS+=("-r" "$REQS_TXT")
    [ -f "$REQS_TEST_TXT" ] && REQS+=("-r" "$REQS_TEST_TXT")

    if [ ${#REQS[@]} -gt 0 ]; then
        "$VENV_PYTHON_CMD" -m pip install "${REQS[@]}"
    fi
}

function build_fonts {
    init_venv

    log "Building fonts..."
    rm -rf "$BUILD"
    mkdir -p "$BUILD"

    # TODO: Add build logic here using fontmake
}

function run_tests {
    init_venv

    log "Running tests..."
    "$PYTEST_CMD" "$ROOT/tests"
}

function update_dependencies {
    init_venv
    log "Updating Python dependencies..."
    "$PIP_CMD" install --upgrade pip pip-tools

    if [ -f "$REQS_IN" ]; then
        log "Compiling main requirements..."
        "$PIP_COMPILE_CMD" --upgrade --resolver=backtracking "$REQS_IN"

        if [ -f "$REQS_TEST_IN" ]; then
            log "Compiling test requirements..."
            "$PIP_COMPILE_CMD" --upgrade --resolver=backtracking \
                --constraint "$REQS_TXT" \
                "$REQS_TEST_IN"
        fi

        log "Syncing environment..."
        if [ -f "$REQS_TEST_TXT" ]; then
            "$PIP_SYNC_CMD" "$REQS_TXT" "$REQS_TEST_TXT"
        else
            "$PIP_SYNC_CMD" "$REQS_TXT"
        fi
    else
        install_dependencies
    fi
    success "Dependencies updated."
}

function clean_all {
    log "Cleaning build artifacts and virtual environment..."

    rm -rf "$BUILD" "$VENV" "$ROOT/out"
    find "$ROOT" -name "*.pyc" -delete

    success "Cleaned all build artifacts and virtual environment."
}

function show_help {
    echo -e "${GREEN}Usage:${NC} ${SCRIPT_NAME} {build|test|update|clean|help}"
    echo
    echo -e "${YELLOW}Commands:${NC}"
    for cmd in "${!COMMAND_MAP_DESC[@]}"; do
        printf "  %-8s %s\n" "$cmd" "${COMMAND_MAP_DESC[$cmd]}"
    done
    echo
    echo -e "${BLUE}Tips:${NC}"
    echo -e "  - Python will be used automatically when needed"
    echo -e "  - Run '${SCRIPT_NAME} update' after pulling new changes to update dependencies"
    exit 1
}

# ========== #
# Main logic #
# ========== #

# Validate command
if [[ -z "$COMMAND" || -z "${COMMAND_MAP_FUNC[$COMMAND]}" ]]; then
    [[ -n "$COMMAND" ]] && error "Unknown command '$COMMAND'"
    show_help
fi

# Forcedly ignore changes to requirements files in git
if command -v git >/dev/null 2>&1; then
    for req_file in "$REQS_TXT" "$REQS_TEST_TXT"; do
        if [ -f "$req_file" ]; then
            git update-index --skip-worktree "$req_file" 2>/dev/null || true
        fi
    done
fi

# Execute command
"${COMMAND_MAP_FUNC[$COMMAND]}"
