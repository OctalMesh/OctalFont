# ============================================================================ #
# OctalFont - environment configuration                                        #
#                                                                              #
# This file ships with the repository and defines the project defaults.        #
# Copy it to .env and adjust any values for your local setup.                  #
#                                                                              #
# .env is listed in .gitignore and will never be committed.                    #
# .env.example IS tracked in git - it is also loaded automatically as the      #
# active default config when no .env is present.                               #
#                                                                              #
# All paths support bash variable expansion; ${REPO_ROOT} is the repository    #
# root resolved at runtime before this file is sourced.                        #
# ============================================================================ #

# ============================================================================ #
#                                   Logging                                    #
# ============================================================================ #

# Verbosity level written to the console and the session log.
# Values (least -> most silent): DEBUG | INFO | SUCCESS | WARN | ERROR | FATAL | OFF
LOG_LEVEL=INFO

# How many days to keep timestamped log directories inside logs/.
# -1 disables automatic cleanup entirely.
# <= -2 erases all existing log directories.
LOG_ERASE_DAYS=7

# Root directory for all per-run log subdirectories.
LOG_DIR="${REPO_ROOT}/logs"

# Disable ANSI colour output. Set to any non-empty value to suppress colour
# codes - useful in CI pipelines, piped output, or terminals without colour.
# NO_COLOR=1

# ============================================================================ #
#                                    Build                                     #
# ============================================================================ #

# Set to 1 to skip fontbakery QA checks after every build.
# Equivalent to passing --no-qa on the command line.
BUILD_NO_QA=0
